<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WireViewLogViewer</AssemblyName>
    <RootNamespace>WireViewViewer</RootNamespace>
    <Version>1.0.0</Version>
    <Product>WireView Log Viewer</Product>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/src</PathMap>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="System.IO.Ports" Version="10.0.13" />
  </ItemGroup>

  <!-- the viewer page is shared with the browser version one folder up -->
  <ItemGroup>
    <EmbeddedResource Include="..\index.html" LogicalName="web/index.html" />
    <EmbeddedResource Include="..\js\*.js" LogicalName="web/js/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>

